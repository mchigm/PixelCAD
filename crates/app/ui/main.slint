// The application window.
//
// This file owns the property/callback contract with Rust and nothing else:
// the visible chrome lives in `linux/chrome.slint` and `macos/chrome.slint`,
// picked at runtime by `ui-style`. Keeping one root window (rather than two
// window types) means `wire_callbacks` in main.rs stays a single code path
// regardless of which platform chrome is showing.

import { Theme } from "common/theme.slint";
import { LayerRow } from "common/types.slint";
import { LinuxChrome } from "linux/chrome.slint";
import { MacOsChrome } from "macos/chrome.slint";
import { SettingsPanel } from "settings/settings_panel.slint";
import { FirstRunDialog } from "common/first_run_dialog.slint";

// Re-exported so the generated Rust API keeps exposing these.
export { LayerRow, Theme }

export component AppWindow inherits Window {
    title: "PixelCAD";
    preferred-width: 1400px;
    preferred-height: 880px;
    // The chrome is dense; below this the toolbar scrolls rather than
    // reflowing, so a floor keeps it usable.
    min-width: 900px;
    min-height: 600px;
    background: Theme.surface-base;
    // Native window decorations are kept on every platform. The macOS
    // traffic lights therefore stay where macOS puts them, and the sketch's
    // "Head" bar is an ordinary in-content bar below them.
    no-frame: false;

    // --- State pushed in from Rust after every Controller mutation. ---
    in property <image> canvas-image;
    in property <int> canvas-display-width;
    in property <int> canvas-display-height;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <[color]> palette-colors;
    in property <int> selected-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> status-message;
    in property <[string]> tool-labels;
    in property <int> selected-tool;
    in property <int> brush-size;
    in property <string> brush-shape;
    in property <int> tolerance;
    in property <int> stroke-opacity;
    in property <[LayerRow]> layers;
    in property <int> active-layer;
    in property <bool> has-selection;
    in property <bool> grid-on;
    in property <bool> has-clipboard;
    in property <[color]> recent-colors;
    in property <int> zoom-level;
    in-out property <string> text-input: "LABEL";
    in-out property <string> size-w: "64";
    in-out property <string> size-h: "64";

    // --- Platform shell state, pushed from settings.rs. ---
    /// "linux" or "macos". Drives which chrome tree renders.
    in-out property <string> ui-style: "linux";
    /// True while the window is really fullscreen (Rust mirrors
    /// `slint::Window::is_fullscreen` into this after every toggle).
    in-out property <bool> is-fullscreen: false;

    // --- State the UI owns and Rust only reads via a callback argument. ---
    in-out property <string> save-path: "session.pxc";
    in-out property <string> project-path: "drawing.pxcproj";
    in-out property <string> swatch-hex: "#1d1d1f";
    property <bool> space-held: false;

    // --- Events Rust handles. ---
    callback pencil-down(float, float);
    callback pan-down(float, float);
    callback pointer-moved(float, float);
    callback pointer-released();
    callback canvas-scrolled(float);
    callback palette-clicked(int);
    callback swatch-applied(string);
    callback tool-selected(int);
    callback brush-size-changed(int);
    callback brush-shape-toggled();
    callback tolerance-changed(int);
    callback stroke-opacity-changed(int);
    callback undo-clicked();
    callback redo-clicked();
    callback save-clicked(string);
    callback save-project-clicked(string);
    callback open-project-clicked(string);
    callback layer-add-clicked();
    callback layer-remove-clicked();
    callback layer-selected(int);
    callback layer-visibility-toggled(int);
    callback selection-cleared();
    callback select-all-clicked();
    callback delete-clicked();
    callback cut-clicked();
    callback copy-clicked();
    callback copy-composite-clicked();
    callback paste-clicked();
    callback flip-clicked(string);
    callback rotate-clicked();
    callback crop-clicked();
    callback grid-toggled();
    callback zoom-fit-clicked();
    callback zoom-actual-clicked();
    callback layer-duplicate-clicked();
    callback layer-merge-clicked();
    callback text-changed(string);
    callback recent-clicked(int);
    callback resize-canvas-clicked(string, string);
    callback scale-selection-clicked(string, string);
    callback layer-up-clicked();
    callback layer-down-clicked();
    callback viewport-resized(float, float);
    /// Opens the settings page.
    callback settings-clicked();
    /// Asks Rust to flip real window fullscreen state.
    callback fullscreen-toggled();

    // --- Settings page state. Mirrors settings.toml; Rust persists on
    // --- `settings-changed` and re-applies the theme immediately.
    in-out property <bool> settings-open: false;
    /// Which settings tab is showing: 0 Basic, 1 Style, 2 Layout.
    in-out property <int> settings-tab: 1;
    in-out property <string> set-ui-style: "auto";
    in-out property <string> set-scheme: "dark";
    in-out property <string> set-design: "cyanotype";
    in-out property <string> set-text-style: "normal";
    in-out property <bool> set-mono-labels: false;
    in-out property <string> set-accent: "";
    in-out property <string> set-icon-size: "16";
    in-out property <string> set-canvas-w: "64";
    in-out property <string> set-canvas-h: "64";
    in-out property <bool> set-autosave: false;
    in-out property <string> set-autosave-interval: "300";
    in-out property <bool> set-confirm-exit: true;
    in-out property <string> set-recent-len: "10";
    callback settings-changed();

    // --- First-run platform confirmation. ---
    in-out property <bool> first-run-open: false;
    in property <string> detected-platform: "Linux";
    in property <bool> windows-fallback: false;
    callback first-run-answered(string);
    /// A raw key press. Rust owns the whole shortcut table so the mapping is
    /// testable without a window; the UI only forwards characters.
    callback key-pressed(string, bool) -> bool;

    forward-focus: fs;

    fs := FocusScope {
        // A FocusScope is not a layout, so without these the chrome would
        // collapse to its preferred size and float in the middle of the
        // window instead of filling it.
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Space) {
                root.space-held = true;
                return accept;
            }
            // `control` covers Ctrl on Linux/Windows; `meta` covers Cmd on
            // macOS. Both are offered to Rust as one "accelerator" flag so
            // the shortcut table does not need to know the platform.
            if (root.key-pressed(event.text, event.modifiers.control || event.modifiers.meta)) {
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space) {
                root.space-held = false;
                return accept;
            }
            return reject;
        }

        if root.ui-style != "macos": LinuxChrome {
            width: 100%;
            height: 100%;
            canvas-image: root.canvas-image;
            canvas-display-width: root.canvas-display-width;
            canvas-display-height: root.canvas-display-height;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
            space-held: root.space-held;
            zoom-level: root.zoom-level;
            tool-labels: root.tool-labels;
            selected-tool: root.selected-tool;
            brush-size: root.brush-size;
            brush-shape: root.brush-shape;
            tolerance: root.tolerance;
            stroke-opacity: root.stroke-opacity;
            palette-colors: root.palette-colors;
            selected-index: root.selected-index;
            recent-colors: root.recent-colors;
            has-selection: root.has-selection;
            has-clipboard: root.has-clipboard;
            grid-on: root.grid-on;
            layers: root.layers;
            active-layer: root.active-layer;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            status-message: root.status-message;
            project-path <=> root.project-path;
            save-path <=> root.save-path;
            swatch-hex <=> root.swatch-hex;
            text-input <=> root.text-input;
            size-w <=> root.size-w;
            size-h <=> root.size-h;

            pencil-down(x, y) => { root.pencil-down(x, y); }
            pan-down(x, y) => { root.pan-down(x, y); }
            pointer-moved(x, y) => { root.pointer-moved(x, y); }
            pointer-released() => { root.pointer-released(); }
            canvas-scrolled(d) => { root.canvas-scrolled(d); }
            viewport-resized(w, h) => { root.viewport-resized(w, h); }
            tool-selected(i) => { root.tool-selected(i); }
            brush-size-changed(v) => { root.brush-size-changed(v); }
            brush-shape-toggled() => { root.brush-shape-toggled(); }
            tolerance-changed(v) => { root.tolerance-changed(v); }
            stroke-opacity-changed(v) => { root.stroke-opacity-changed(v); }
            palette-clicked(i) => { root.palette-clicked(i); }
            recent-clicked(i) => { root.recent-clicked(i); }
            swatch-applied(h) => { root.swatch-applied(h); }
            cut-clicked() => { root.cut-clicked(); }
            copy-clicked() => { root.copy-clicked(); }
            copy-composite-clicked() => { root.copy-composite-clicked(); }
            paste-clicked() => { root.paste-clicked(); }
            delete-clicked() => { root.delete-clicked(); }
            select-all-clicked() => { root.select-all-clicked(); }
            selection-cleared() => { root.selection-cleared(); }
            crop-clicked() => { root.crop-clicked(); }
            rotate-clicked() => { root.rotate-clicked(); }
            flip-clicked(a) => { root.flip-clicked(a); }
            resize-canvas-clicked(w, h) => { root.resize-canvas-clicked(w, h); }
            scale-selection-clicked(w, h) => { root.scale-selection-clicked(w, h); }
            text-changed(t) => { root.text-changed(t); }
            undo-clicked() => { root.undo-clicked(); }
            redo-clicked() => { root.redo-clicked(); }
            save-clicked(p) => { root.save-clicked(p); }
            save-project-clicked(p) => { root.save-project-clicked(p); }
            open-project-clicked(p) => { root.open-project-clicked(p); }
            layer-add-clicked() => { root.layer-add-clicked(); }
            layer-remove-clicked() => { root.layer-remove-clicked(); }
            layer-selected(i) => { root.layer-selected(i); }
            layer-visibility-toggled(i) => { root.layer-visibility-toggled(i); }
            layer-duplicate-clicked() => { root.layer-duplicate-clicked(); }
            layer-merge-clicked() => { root.layer-merge-clicked(); }
            layer-up-clicked() => { root.layer-up-clicked(); }
            layer-down-clicked() => { root.layer-down-clicked(); }
            grid-toggled() => { root.grid-toggled(); }
            zoom-fit-clicked() => { root.zoom-fit-clicked(); }
            zoom-actual-clicked() => { root.zoom-actual-clicked(); }
            settings-clicked() => { root.settings-clicked(); }
        }

        if root.ui-style == "macos": MacOsChrome {
            width: 100%;
            height: 100%;
            canvas-image: root.canvas-image;
            canvas-display-width: root.canvas-display-width;
            canvas-display-height: root.canvas-display-height;
            pan-x: root.pan-x;
            pan-y: root.pan-y;
            space-held: root.space-held;
            zoom-level: root.zoom-level;
            tool-labels: root.tool-labels;
            selected-tool: root.selected-tool;
            brush-size: root.brush-size;
            brush-shape: root.brush-shape;
            tolerance: root.tolerance;
            stroke-opacity: root.stroke-opacity;
            palette-colors: root.palette-colors;
            selected-index: root.selected-index;
            recent-colors: root.recent-colors;
            has-selection: root.has-selection;
            has-clipboard: root.has-clipboard;
            grid-on: root.grid-on;
            layers: root.layers;
            active-layer: root.active-layer;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            status-message: root.status-message;
            is-fullscreen: root.is-fullscreen;
            project-path <=> root.project-path;
            save-path <=> root.save-path;
            swatch-hex <=> root.swatch-hex;
            text-input <=> root.text-input;
            size-w <=> root.size-w;
            size-h <=> root.size-h;

            pencil-down(x, y) => { root.pencil-down(x, y); }
            pan-down(x, y) => { root.pan-down(x, y); }
            pointer-moved(x, y) => { root.pointer-moved(x, y); }
            pointer-released() => { root.pointer-released(); }
            canvas-scrolled(d) => { root.canvas-scrolled(d); }
            viewport-resized(w, h) => { root.viewport-resized(w, h); }
            tool-selected(i) => { root.tool-selected(i); }
            brush-size-changed(v) => { root.brush-size-changed(v); }
            brush-shape-toggled() => { root.brush-shape-toggled(); }
            tolerance-changed(v) => { root.tolerance-changed(v); }
            stroke-opacity-changed(v) => { root.stroke-opacity-changed(v); }
            palette-clicked(i) => { root.palette-clicked(i); }
            recent-clicked(i) => { root.recent-clicked(i); }
            swatch-applied(h) => { root.swatch-applied(h); }
            cut-clicked() => { root.cut-clicked(); }
            copy-clicked() => { root.copy-clicked(); }
            copy-composite-clicked() => { root.copy-composite-clicked(); }
            paste-clicked() => { root.paste-clicked(); }
            delete-clicked() => { root.delete-clicked(); }
            select-all-clicked() => { root.select-all-clicked(); }
            selection-cleared() => { root.selection-cleared(); }
            crop-clicked() => { root.crop-clicked(); }
            rotate-clicked() => { root.rotate-clicked(); }
            flip-clicked(a) => { root.flip-clicked(a); }
            resize-canvas-clicked(w, h) => { root.resize-canvas-clicked(w, h); }
            scale-selection-clicked(w, h) => { root.scale-selection-clicked(w, h); }
            text-changed(t) => { root.text-changed(t); }
            undo-clicked() => { root.undo-clicked(); }
            redo-clicked() => { root.redo-clicked(); }
            save-clicked(p) => { root.save-clicked(p); }
            save-project-clicked(p) => { root.save-project-clicked(p); }
            open-project-clicked(p) => { root.open-project-clicked(p); }
            layer-add-clicked() => { root.layer-add-clicked(); }
            layer-remove-clicked() => { root.layer-remove-clicked(); }
            layer-selected(i) => { root.layer-selected(i); }
            layer-visibility-toggled(i) => { root.layer-visibility-toggled(i); }
            layer-duplicate-clicked() => { root.layer-duplicate-clicked(); }
            layer-merge-clicked() => { root.layer-merge-clicked(); }
            layer-up-clicked() => { root.layer-up-clicked(); }
            layer-down-clicked() => { root.layer-down-clicked(); }
            grid-toggled() => { root.grid-toggled(); }
            zoom-fit-clicked() => { root.zoom-fit-clicked(); }
            zoom-actual-clicked() => { root.zoom-actual-clicked(); }
            settings-clicked() => { root.settings-clicked(); }
            fullscreen-toggled() => { root.fullscreen-toggled(); }
        }

        // Overlays sit above both chrome trees, so they are declared once.
        if root.settings-open: SettingsPanel {
            width: 100%;
            height: 100%;
            is-linux: root.ui-style != "macos";
            tab <=> root.settings-tab;

            ui-style-choice <=> root.set-ui-style;
            scheme-choice <=> root.set-scheme;
            design-choice <=> root.set-design;
            text-style-choice <=> root.set-text-style;
            mono-labels <=> root.set-mono-labels;
            accent-hex <=> root.set-accent;
            icon-size-choice <=> root.set-icon-size;
            canvas-w <=> root.set-canvas-w;
            canvas-h <=> root.set-canvas-h;
            autosave <=> root.set-autosave;
            autosave-interval <=> root.set-autosave-interval;
            confirm-exit <=> root.set-confirm-exit;
            recent-len <=> root.set-recent-len;

            changed() => { root.settings-changed(); }
            closed() => { root.settings-open = false; }
        }

        if root.first-run-open: FirstRunDialog {
            width: 100%;
            height: 100%;
            detected: root.detected-platform;
            windows-fallback: root.windows-fallback;
            answered(choice) => { root.first-run-answered(choice); }
        }
    }
}
