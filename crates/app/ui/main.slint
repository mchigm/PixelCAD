import { Button, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";

export struct LayerRow {
    name: string,
    visible: bool,
}

export component AppWindow inherits Window {
    title: "PixelCAD";
    preferred-width: 1080px;
    preferred-height: 680px;

    // --- State pushed in from Rust after every Controller mutation. ---
    in property <image> canvas-image;
    in property <int> canvas-display-width;
    in property <int> canvas-display-height;
    in property <float> pan-x;
    in property <float> pan-y;
    in property <[color]> palette-colors;
    in property <int> selected-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> status-message;
    in property <[string]> tool-labels;
    in property <int> selected-tool;
    in property <int> brush-size;
    in property <string> brush-shape;
    in property <int> tolerance;
    in property <int> stroke-opacity;
    in property <[LayerRow]> layers;
    in property <int> active-layer;
    in property <bool> has-selection;
    in property <bool> grid-on;
    in property <bool> has-clipboard;
    in property <[color]> recent-colors;
    in property <int> zoom-level;
    in-out property <string> text-input: "LABEL";
    in-out property <string> size-w: "64";
    in-out property <string> size-h: "64";

    // --- State the UI owns and Rust only reads via a callback argument. ---
    in-out property <string> save-path: "session.pxc";
    in-out property <string> project-path: "drawing.pxcproj";
    in-out property <string> swatch-hex: "#1d1d1f";
    property <bool> space-held: false;

    // --- Events Rust handles. ---
    callback pencil-down(float, float);
    callback pan-down(float, float);
    callback pointer-moved(float, float);
    callback pointer-released();
    callback canvas-scrolled(float);
    callback palette-clicked(int);
    callback swatch-applied(string);
    callback tool-selected(int);
    callback brush-size-changed(int);
    callback brush-shape-toggled();
    callback tolerance-changed(int);
    callback stroke-opacity-changed(int);
    callback undo-clicked();
    callback redo-clicked();
    callback save-clicked(string);
    callback save-project-clicked(string);
    callback open-project-clicked(string);
    callback layer-add-clicked();
    callback layer-remove-clicked();
    callback layer-selected(int);
    callback layer-visibility-toggled(int);
    callback selection-cleared();
    callback select-all-clicked();
    callback delete-clicked();
    callback cut-clicked();
    callback copy-clicked();
    callback copy-composite-clicked();
    callback paste-clicked();
    callback flip-clicked(string);
    callback rotate-clicked();
    callback crop-clicked();
    callback grid-toggled();
    callback zoom-fit-clicked();
    callback zoom-actual-clicked();
    callback layer-duplicate-clicked();
    callback layer-merge-clicked();
    callback text-changed(string);
    callback recent-clicked(int);
    callback resize-canvas-clicked(string, string);
    callback scale-selection-clicked(string, string);
    callback layer-up-clicked();
    callback layer-down-clicked();
    callback viewport-resized(float, float);
    /// A raw key press. Rust owns the whole shortcut table so the mapping is
    /// testable without a window; the UI only forwards characters.
    callback key-pressed(string, bool) -> bool;

    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space) {
                root.space-held = true;
                return accept;
            }
            // `control` covers Ctrl on Linux/Windows; `meta` covers Cmd on
            // macOS. Both are offered to Rust as one "accelerator" flag so
            // the shortcut table does not need to know the platform.
            if (root.key-pressed(event.text, event.modifiers.control || event.modifiers.meta)) {
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Space) {
                root.space-held = false;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // ---------------------------------------------------- toolbar
            HorizontalLayout {
                spacing: 6px;
                height: 32px;

                undo-btn := Button {
                    text: "Undo";
                    enabled: root.can-undo;
                    clicked => { root.undo-clicked(); }
                }
                redo-btn := Button {
                    text: "Redo";
                    enabled: root.can-redo;
                    clicked => { root.redo-clicked(); }
                }
                Rectangle { width: 8px; }
                project-edit := LineEdit {
                    text <=> root.project-path;
                    width: 170px;
                }
                open-btn := Button {
                    text: "Open";
                    clicked => { root.open-project-clicked(root.project-path); }
                }
                save-project-btn := Button {
                    text: "Save project";
                    clicked => { root.save-project-clicked(root.project-path); }
                }
                Rectangle { width: 8px; }
                path-edit := LineEdit {
                    text <=> root.save-path;
                    width: 150px;
                }
                save-btn := Button {
                    text: "Save script";
                    clicked => { root.save-clicked(root.save-path); }
                }
                Text {
                    text: root.status-message;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                height: 30px;

                select-all-btn := Button {
                    text: "All";
                    clicked => { root.select-all-clicked(); }
                }
                cut-btn := Button {
                    text: "Cut";
                    enabled: root.has-selection;
                    clicked => { root.cut-clicked(); }
                }
                copy-btn := Button {
                    text: "Copy";
                    clicked => { root.copy-clicked(); }
                }
                copy-composite-btn := Button {
                    text: "Copy vis.";
                    clicked => { root.copy-composite-clicked(); }
                }
                paste-btn := Button {
                    text: "Paste";
                    enabled: root.has-clipboard;
                    clicked => { root.paste-clicked(); }
                }
                delete-btn := Button {
                    text: "Delete";
                    enabled: root.has-selection;
                    clicked => { root.delete-clicked(); }
                }
                Rectangle { width: 6px; }
                flip-h-btn := Button {
                    text: "Flip H";
                    enabled: root.has-selection;
                    clicked => { root.flip-clicked("horizontal"); }
                }
                flip-v-btn := Button {
                    text: "Flip V";
                    enabled: root.has-selection;
                    clicked => { root.flip-clicked("vertical"); }
                }
                rotate-btn := Button {
                    text: "Rotate";
                    enabled: root.has-selection;
                    clicked => { root.rotate-clicked(); }
                }
                crop-btn := Button {
                    text: "Crop";
                    enabled: root.has-selection;
                    clicked => { root.crop-clicked(); }
                }
                Rectangle { width: 6px; }
                w-edit := LineEdit { text <=> root.size-w; width: 52px; }
                h-edit := LineEdit { text <=> root.size-h; width: 52px; }
                resize-btn := Button {
                    text: "Resize";
                    clicked => { root.resize-canvas-clicked(root.size-w, root.size-h); }
                }
                scale-sel-btn := Button {
                    text: "Scale sel";
                    enabled: root.has-selection;
                    clicked => { root.scale-selection-clicked(root.size-w, root.size-h); }
                }
                Rectangle { width: 6px; }
                grid-btn := Button {
                    text: root.grid-on ? "Grid on" : "Grid off";
                    clicked => { root.grid-toggled(); }
                }
                zoom-fit-btn := Button {
                    text: "Fit";
                    clicked => { root.zoom-fit-clicked(); }
                }
                zoom-actual-btn := Button {
                    text: "1:1";
                    clicked => { root.zoom-actual-clicked(); }
                }
                Text {
                    text: root.zoom-level + "x";
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 12px;

                // ------------------------------------------- left sidebar
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    width: 200px;

                    Text { text: "Tools"; font-weight: 700; }
                    for label[i] in root.tool-labels: tool-btn := Button {
                        text: label;
                        primary: root.selected-tool == i;
                        clicked => { root.tool-selected(i); }
                    }

                    Rectangle { height: 4px; }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "Brush " + root.brush-size;
                            vertical-alignment: center;
                        }
                        brush-down-btn := Button {
                            text: "-";
                            clicked => { root.brush-size-changed(root.brush-size - 1); }
                        }
                        brush-up-btn := Button {
                            text: "+";
                            clicked => { root.brush-size-changed(root.brush-size + 1); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        brush-shape-btn := Button {
                            text: root.brush-shape;
                            clicked => { root.brush-shape-toggled(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "Tol " + root.tolerance;
                            vertical-alignment: center;
                        }
                        tol-down-btn := Button {
                            text: "-";
                            clicked => { root.tolerance-changed(root.tolerance - 8); }
                        }
                        tol-up-btn := Button {
                            text: "+";
                            clicked => { root.tolerance-changed(root.tolerance + 8); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: "Op " + root.stroke-opacity;
                            vertical-alignment: center;
                        }
                        op-down-btn := Button {
                            text: "-";
                            clicked => { root.stroke-opacity-changed(root.stroke-opacity - 32); }
                        }
                        op-up-btn := Button {
                            text: "+";
                            clicked => { root.stroke-opacity-changed(root.stroke-opacity + 32); }
                        }
                    }

                    deselect-btn := Button {
                        text: "Clear selection";
                        enabled: root.has-selection;
                        clicked => { root.selection-cleared(); }
                    }

                    Rectangle { height: 4px; }

                    Text { text: "Palette"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 2px;
                        for i in 8: Rectangle {
                            width: 22px;
                            height: 22px;
                            background: root.palette-colors[i];
                            border-width: root.selected-index == i ? 3px : 1px;
                            border-color: root.selected-index == i ? black : #808080;

                            swatch-row1 := TouchArea {
                                clicked => { root.palette-clicked(i); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 2px;
                        for i in 8: Rectangle {
                            width: 22px;
                            height: 22px;
                            background: root.palette-colors[i + 8];
                            border-width: root.selected-index == (i + 8) ? 3px : 1px;
                            border-color: root.selected-index == (i + 8) ? black : #808080;

                            swatch-row2 := TouchArea {
                                clicked => { root.palette-clicked(i + 8); }
                            }
                        }
                    }
                    Text { text: "Recent"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 2px;
                        height: 18px;
                        for c[i] in root.recent-colors: Rectangle {
                            width: 18px;
                            height: 18px;
                            background: c;
                            border-width: 1px;
                            border-color: #808080;
                            recent-swatch := TouchArea {
                                clicked => { root.recent-clicked(i); }
                            }
                        }
                    }

                    Text { text: "Text tool"; font-weight: 700; }
                    text-edit := LineEdit {
                        text <=> root.text-input;
                        width: 170px;
                        edited => { root.text-changed(self.text); }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        hex-edit := LineEdit {
                            text <=> root.swatch-hex;
                            width: 100px;
                        }
                        apply-swatch-btn := Button {
                            text: "Set";
                            clicked => { root.swatch-applied(root.swatch-hex); }
                        }
                    }
                }

                // ------------------------------------------------- canvas
                viewport := Rectangle {
                    min-width: 512px;
                    clip: true;
                    background: #2b2b2b;

                    // Report our real size to Rust so "Fit" is exact.
                    changed width => { root.viewport-resized(self.width / 1px, self.height / 1px); }
                    changed height => { root.viewport-resized(self.width / 1px, self.height / 1px); }

                    Image {
                        source: root.canvas-image;
                        image-rendering: pixelated;
                        x: root.pan-x * 1px;
                        y: root.pan-y * 1px;
                        width: root.canvas-display-width * 1px;
                        height: root.canvas-display-height * 1px;
                    }

                    canvas-touch := TouchArea {
                        width: 100%;
                        height: 100%;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                if (event.button == PointerEventButton.left) {
                                    if (root.space-held) {
                                        root.pan-down(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else {
                                        root.pencil-down(self.mouse-x / 1px, self.mouse-y / 1px);
                                    }
                                } else if (event.button == PointerEventButton.right) {
                                    root.pan-down(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                root.pointer-released();
                            }
                        }
                        moved => {
                            root.pointer-moved(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                        scroll-event(event) => {
                            root.canvas-scrolled(event.delta-y / 1px);
                            return accept;
                        }
                    }
                }

                // ------------------------------------------ right sidebar
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    width: 190px;

                    Text { text: "Layers (top first)"; font-weight: 700; }
                    layer-add-btn := Button {
                        text: "Add layer";
                        clicked => { root.layer-add-clicked(); }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        layer-up-btn := Button {
                            text: "Raise";
                            clicked => { root.layer-up-clicked(); }
                        }
                        layer-down-btn := Button {
                            text: "Lower";
                            clicked => { root.layer-down-clicked(); }
                        }
                    }
                    layer-duplicate-btn := Button {
                        text: "Duplicate layer";
                        clicked => { root.layer-duplicate-clicked(); }
                    }
                    layer-merge-btn := Button {
                        text: "Merge down";
                        enabled: root.layers.length > 1;
                        clicked => { root.layer-merge-clicked(); }
                    }
                    layer-remove-btn := Button {
                        text: "Delete layer";
                        enabled: root.layers.length > 1;
                        clicked => { root.layer-remove-clicked(); }
                    }

                    // Displayed top-first, which is the opposite of the
                    // model's bottom-first order; Rust converts the index.
                    for row[i] in root.layers: Rectangle {
                        height: 26px;
                        background: root.active-layer == (root.layers.length - 1 - i)
                            ? #4a6fa5 : transparent;
                        border-width: 1px;
                        border-color: #808080;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;

                            layer-visible-box := CheckBox {
                                checked: row.visible;
                                toggled => {
                                    root.layer-visibility-toggled(root.layers.length - 1 - i);
                                }
                            }
                            Text {
                                text: row.name;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }

                        // Offset past the visibility checkbox so that
                        // clicking the eye toggles it rather than merely
                        // selecting the row.
                        layer-row-touch := TouchArea {
                            x: 34px;
                            width: parent.width - 34px;
                            clicked => { root.layer-selected(root.layers.length - 1 - i); }
                        }
                    }
                }
            }
        }
    }
}
